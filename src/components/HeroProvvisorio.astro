---
// Hero provvisorio: sezione statica in attesa della sequenza scroll-driven
// del Task 6. Nessuna animazione qui.
import societa from "../data/societa.json";
const righeClaim = societa.claimHome.split(/\r?\n/).filter(Boolean);
---
<section class="hero-provvisorio">
  <img src="/img/stemma-500.png" alt="Stemma Longi 1969" width="500" height="500" class="stemma" />
  <h1 class="font-display">LONGI 1969</h1>
  <p class="claim font-display">
    {righeClaim.map((riga) => <span class="linea">{riga}</span>)}
  </p>
  <p class="sottotitolo">Campioni di Terza Categoria e Trofeo delle Province 2025/26</p>
</section>
<style>
  .hero-provvisorio {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    background: var(--bg);
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem);
  }
  .stemma {
    width: clamp(140px, 26vw, 260px);
    height: auto;
  }
  .hero-provvisorio h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2.5rem, 8vw, 5rem);
  }
  .claim {
    margin: 0;
    color: var(--oro);
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    line-height: 1.3;
  }
  .claim .linea {
    display: block;
  }
  .sottotitolo {
    margin: 0;
    max-width: 40ch;
    color: var(--text);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
  }
</style>
