---
import type { CollectionEntry } from "astro:content";

interface Props {
  player: CollectionEntry<"giocatori">;
}
const { player } = Astro.props;
const { nome, ruolo, numero, foto } = player.data;
const hasFoto = Boolean(foto);
const alt = hasFoto ? `Foto di ${nome}` : `Segnaposto: foto non disponibile per ${nome}`;
---
<button
  type="button"
  class="player-card"
  data-player
  data-nome={nome}
  data-ruolo={ruolo}
  data-numero={numero ?? ""}
  data-foto={foto ?? ""}
  aria-label={`Apri la scheda di ${nome}`}
>
  <div class="photo-wrap">
    <img src={foto || "/img/silhouette.svg"} alt={alt} class="photo" loading="lazy" />
    {numero !== undefined && (
      <span class="number">
        <span class="visually-hidden">Numero di maglia </span>{numero}
      </span>
    )}
  </div>
  <div class="info">
    <p class="nome">{nome}</p>
    <p class="ruolo">{ruolo}</p>
  </div>
</button>
<style>
  .player-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    /* e' un <button> per accessibilita' (tastiera, ruolo), ma non deve
       sembrarlo: niente bordo, niente sfondo di sistema. */
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    width: 100%;
    transition: transform 0.25s var(--ease-out-quart);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .player-card:hover,
  .player-card:focus-visible {
    transform: translateY(-3px);
  }
  /* Colpo di luce del leone: una lama dorata obliqua attraversa la card
     su hover/focus. Solo trasformazioni (compositor), niente layout. */
  .player-card::after {
    content: "";
    position: absolute;
    inset: -20% auto -20% -45%;
    width: 35%;
    background: linear-gradient(
      105deg,
      transparent,
      oklch(0.82 0.15 92 / 0.28) 45%,
      oklch(0.95 0.1 92 / 0.42) 50%,
      oklch(0.82 0.15 92 / 0.28) 55%,
      transparent
    );
    transform: translateX(0) skewX(-12deg);
    pointer-events: none;
    z-index: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .player-card:hover::after,
    .player-card:focus-visible::after {
      transition: transform 0.55s var(--ease-out-quart);
      transform: translateX(480%) skewX(-12deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .player-card { transition: none; }
    .player-card::after { display: none; }
  }
  .photo-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .number {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.1rem 0.5rem;
    background: var(--bg);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    line-height: 1;
    color: var(--oro);
    text-shadow: 0 2px 14px color-mix(in oklch, var(--bg) 85%, transparent);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .info {
    flex: 1;
    padding: 0.75rem 0.9rem 1rem;
  }
  .nome {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.05rem;
    margin: 0;
  }
  .ruolo {
    color: var(--oro);
    font-size: 0.85rem;
    margin: 0.2rem 0 0;
  }
</style>
