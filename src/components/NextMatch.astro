---
// Le due partite che contano per chi apre la home: quella appena giocata e
// quella che arriva. Affiancate su schermo largo, impilate su telefono.
import TuttocampoWidget from "./TuttocampoWidget.astro";
---
<section class="match-strip" aria-labelledby="match-strip-title">
  <div class="inner">
    <h2 id="match-strip-title" class="visually-hidden">Partite</h2>

    <div class="coppia">
      <div class="riquadro" data-reveal>
        <h3 class="font-display">Ultima partita</h3>
        <TuttocampoWidget type="partita" title="Ultima partita giocata - widget Tuttocampo" />
      </div>

      <div class="riquadro" data-reveal>
        <h3 class="font-display">Prossima partita</h3>
        <TuttocampoWidget type="prossimaPartita" title="Prossima partita - widget Tuttocampo" />
      </div>
    </div>
  </div>
</section>
<style>
  .match-strip {
    background: var(--surface);
    padding: clamp(3rem, 7vw, 5rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .coppia {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3rem);
  }

  /* Wipe diagonale: i tabelloni si rivelano col taglio obliquo dello scudo
     (stessa grammatica della Spaccatura), uno da sinistra e uno da destra,
     legati allo scroll. SOLO proprieta' animation-* estese: il minificatore
     fonde la scorciatoia con animation-timeline e il browser scarta tutto
     (bug documentato in tana.css). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .riquadro {
        animation-name: wipe-scudo-sx;
        animation-duration: 1s;
        animation-fill-mode: both;
        animation-timing-function: var(--ease-out-quart);
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
      .riquadro:last-child {
        animation-name: wipe-scudo-dx;
      }
    }
  }

  @keyframes wipe-scudo-sx {
    from {
      opacity: 0;
      clip-path: polygon(0 0, 12% 0, -8% 100%, 0 100%);
      transform: translateX(-1.25rem);
    }
    to {
      opacity: 1;
      clip-path: polygon(0 0, 120% 0, 100% 100%, 0 100%);
      transform: translateX(0);
    }
  }
  @keyframes wipe-scudo-dx {
    from {
      opacity: 0;
      clip-path: polygon(88% 0, 100% 0, 100% 100%, 108% 100%);
      transform: translateX(1.25rem);
    }
    to {
      opacity: 1;
      clip-path: polygon(-20% 0, 100% 0, 100% 100%, 0 100%);
      transform: translateX(0);
    }
  }

  /* Ripiego senza animation-timeline: lo script in Base.astro marca gli
     elementi [data-reveal] e accende .reveal-on via IntersectionObserver. */
  .riquadro.reveal-js {
    opacity: 0;
    clip-path: polygon(0 0, 12% 0, -8% 100%, 0 100%);
    transform: translateX(-1.25rem);
    transition:
      opacity 0.9s var(--ease-out-quart),
      clip-path 0.9s var(--ease-out-quart),
      transform 0.9s var(--ease-out-quart);
  }
  .riquadro:last-child.reveal-js {
    clip-path: polygon(88% 0, 100% 0, 100% 100%, 108% 100%);
    transform: translateX(1.25rem);
    transition-delay: 0.12s;
  }
  .riquadro.reveal-on {
    opacity: 1;
    clip-path: polygon(-20% 0, 120% 0, 100% 100%, 0 100%);
    transform: translateX(0);
  }
  /* Affiancate solo quando c'e' spazio vero: sotto i 860px due tabellini
     stretti diventano illeggibili. */
  @media (min-width: 860px) {
    .coppia {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .riquadro h3 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    margin: 0 0 1.25rem;
    text-align: center;
  }
</style>
